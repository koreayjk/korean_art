---
import { copy, type Locale } from '../data/copy';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer__cols">
    <div class="footer__brand">
      <div class="footer__mark">
        <span class="seal" aria-hidden="true"><span>아</span><span>람</span></span>
        <span class="footer__name">ARAM</span>
      </div>
      <p>{t.footer.blurb}</p>
    </div>

    <nav class="footer__col" aria-label="Footer">
      {t.nav.map((item) => <a class="link link--plain" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer__col">
      <a class="link link--plain" href="#inquiry">{t.inquiry}</a>
      <a class="link link--plain" href="#inquiry">{t.institutions}</a>
      <span>{site.email}</span>
    </div>

    <div class="footer__col">
      <a class={`link${locale === 'en' ? '' : ' link--plain'}`} href={`${base}${copy.en.path}`} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>English</a>
      <a class={`link${locale === 'ko' ? '' : ' link--plain'}`} href={`${base}${copy.ko.path}`} lang="ko" hreflang="ko" aria-current={locale === 'ko' ? 'true' : undefined} style="font-family: var(--korean)">한국어</a>
    </div>
  </div>

  <div class="footer__base">
    <div>© {new Date().getFullYear()} ARAM</div>
    <div>{t.footer.location}</div>
  </div>
</footer>
