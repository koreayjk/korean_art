---
import { copy, type Locale } from '../data/copy';
import { url } from '../data/links';

interface Props {
  locale: Locale;
  onHome?: boolean;
}

const { locale, onHome = false } = Astro.props;
const t = copy[locale];
---

<header class:list={['header', { 'header--page is-solid': !onHome }]} data-header>
  <div class="header__bg" aria-hidden="true"></div>
  <div class="header__progress" aria-hidden="true" data-progress></div>

  <nav class="header__nav" aria-label="Main">
    {t.nav.map((item) => <a class="link link--plain" href={url(locale, item.key, onHome)}>{item.label}</a>)}
  </nav>
  <button
    class="header__menu"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
    data-label-open={t.menu}
    data-label-close={t.menuClose}>{t.menu}</button>

  <a class="header__logo" href={url(locale, 'home', onHome)} aria-label={t.homeLabel} data-logo>ARAM</a>

  <div class="header__side">
    <a class="link link--plain" href={url(locale, 'inquiry')}>{t.inquiry}</a>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  {t.nav.map((item) => <a href={url(locale, item.key, onHome)}>{item.label}</a>)}
  <a href={url(locale, 'inquiry')}>{t.inquiry}</a>
</div>
