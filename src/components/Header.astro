---
import { copy, type Locale } from '../data/copy';

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
---

<header class="header" data-header>
  <div class="header__bg" aria-hidden="true"></div>
  <div class="header__progress" aria-hidden="true" data-progress></div>

  <nav class="header__nav" aria-label="Main">
    {t.nav.map((item) => <a class="link link--plain" href={item.href}>{item.label}</a>)}
  </nav>
  <button
    class="header__menu"
    type="button"
    aria-expanded="false"
    aria-controls="menu"
    data-menu-toggle
    data-label-open={t.menu}
    data-label-close={t.menuClose}>{t.menu}</button>

  <a class="header__logo" href="#top" aria-label={t.homeLabel} data-logo>ARAM</a>

  <div class="header__side">
    <a class="link link--plain" href="#inquiry">{t.inquiry}</a>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  {t.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  <a href="#inquiry">{t.inquiry}</a>
</div>
