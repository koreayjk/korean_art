---
import { nav } from '../data/site';
---

<header class="header" data-header>
  <div class="header__bg" aria-hidden="true"></div>
  <div class="header__progress" aria-hidden="true" data-progress></div>

  <nav class="header__nav" aria-label="Main">
    {nav.map((item) => <a class="link link--plain" href={item.href}>{item.label}</a>)}
  </nav>
  <button class="header__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>Menu</button>

  <a class="header__logo" href="#top" aria-label="ARAM, home" data-logo>ARAM</a>

  <div class="header__side">
    <a class="link link--plain" href="#inquiry">Inquiry</a>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  <a href="#inquiry">Inquiry</a>
</div>
